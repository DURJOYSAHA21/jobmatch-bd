# Local dev: leave unset to use a local SQLite file automatically.
# Deployment: set to your Postgres connection string, e.g.
# postgresql://user:password@host:5432/dbname  (Neon/Supabase give you this)
DATABASE_URL=

# Comma-separated list of origins allowed to call this API.
# Local dev default matches the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# How many ranked matches /match/{profile_id} returns by default.
DEFAULT_MATCH_LIMIT=20

# RapidAPI key for JSearch (free tier: 200 req/month).
# Get one at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# ── Email alerts (optional) ──
# When new jobs are fetched/seeded, profiles with an email get a digest
# of matches scoring >= MATCH_EMAIL_THRESHOLD.
# Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
MATCH_EMAIL_THRESHOLD=50
